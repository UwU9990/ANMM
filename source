-- NOCLIP/FLIGHT HANDLER --

local noclipEnabled = false
local flyEnabled = false

local flySpeed = 50
local flyMult = 3.0
local flightPos = nil

local keysDown = {}

local savedCollide = {}

UserInputService.InputBegan:Connect(function(input)
	if UserInputService:GetFocusedTextBox() then return end
	if input.UserInputType == Enum.UserInputType.Keyboard then
		keysDown[input.KeyCode] = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		keysDown[input.KeyCode] = nil
	end
end)

local function getCharacter()
	return player.Character or workspace:FindFirstChild(player.Name)
end

local function setCharacterNoclip(char, state)
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			if state then
				if savedCollide[part] == nil then
					savedCollide[part] = part.CanCollide
				end
				part.CanCollide = false
			else
				if savedCollide[part] ~= nil then
					part.CanCollide = savedCollide[part]
					savedCollide[part] = nil
				end
			end
		end
	end
end

local function setCharacterFly(char, state)
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if hum then
		hum.PlatformStand = state
	end
	if root then
		root.Anchored = state
		root.Velocity = Vector3.new(0, 0, 0)
		if state then
			flightPos = root.Position
		end
	end
end

local function enforceNoclip()
	if noclipEnabled then
		setCharacterNoclip(getCharacter(), true)
	end
end

RunService.Stepped:Connect(enforceNoclip)
RunService.Heartbeat:Connect(enforceNoclip)

RunService.RenderStepped:Connect(function(dt)
	if not flyEnabled then return end

	local cam = workspace.CurrentCamera
	local char = getCharacter()
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not cam or not root or not hum then return end

	hum.PlatformStand = true
	root.Anchored = true

	if not flightPos then
		flightPos = root.Position
	end

	local pressed = {}
	for _, input in ipairs(UserInputService:GetKeysPressed()) do
		pressed[input.KeyCode] = true
	end

	local camCF = cam.CFrame
	local forward = camCF.LookVector
	local right = camCF.RightVector
	local up = Vector3.new(0, 1, 0)

	local moveDelta = Vector3.new(0, 0, 0)
	if pressed[Enum.KeyCode.W] then moveDelta = moveDelta + forward end
	if pressed[Enum.KeyCode.S] then moveDelta = moveDelta - forward end
	if pressed[Enum.KeyCode.D] then moveDelta = moveDelta + right end
	if pressed[Enum.KeyCode.A] then moveDelta = moveDelta - right end
	if pressed[Enum.KeyCode.Space] then moveDelta = moveDelta + up end
	if pressed[Enum.KeyCode.LeftControl] then moveDelta = moveDelta - up end

	local currentSpeed = flySpeed
	if pressed[Enum.KeyCode.LeftShift] then
		currentSpeed = currentSpeed * flyMult
	end

	flightPos = flightPos + (moveDelta * currentSpeed * dt)
	root.CFrame = CFrame.new(flightPos) * (camCF - camCF.Position)
end)

-- FUNCTIONS --

local function notify(title, message, time)
	local events = ReplicatedStorage:WaitForChild("Events")
	local notifyBindable = events:WaitForChild("NotifyBindable")

	if notifyBindable then
		notifyBindable:Fire(title, message, time)
	end
end

-- SERVER STATUS HANDLER --

local function checkStatus()
	local fetchSuccess, response = pcall(function()
		-- print("Checking server...")
		return game:HttpGet(statusUrl .. "?t=" .. tostring(os.time()))
	end)

	if not fetchSuccess or not response or response == "" then
		-- print("Failed to fetch server...")
		return
	end
    -- print("Fetched server status...")

	local decodeSuccess, data = pcall(function()
		return HttpService:JSONDecode(response)
	end)

	if not decodeSuccess or type(data) ~= "table" or type(data.content) ~= "table" then
		return
	end

	local content = data.content
	local remoteVersion = content.version
	local serverMessage = content["server-message"]
	local updateMessage = content["update-message"]

	if remoteVersion and remoteVersion ~= currentVersion then
		local msg = updateMessage or ("Your version of ANMM " .. currentVersion .. " is out of date!")
		msg = msg:gsub("{version}", currentVersion)

		notify("Update Available", msg)
	end

	if serverMessage and serverMessage ~= "" and serverMessage ~= lastServerMessage then
		local formattedServerMsg = serverMessage
		notify("Server", formattedServerMsg)
		lastServerMessage = serverMessage
	end
end

task.spawn(function()
	checkStatus()
	while task.wait(checkInterval) do
		checkStatus()
	end
end)

